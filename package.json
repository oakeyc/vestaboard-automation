{
  "name": "vestaboard-automation",
  "version": "0.1.0",
  "description": "Personal automation for sending messages to a Vestaboard.",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node src/index.js",
    "read": "node src/cli/read.js",
    "send": "node src/cli/send.js",
    "calendar": "node src/cli/calendar.js --send",
    "calendar:test": "node src/cli/calendar.js",
    "calendar:auth": "node src/cli/calendar-auth.js",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "check": "biome check .",
    "check:fix": "biome check --write ."
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "googleapis": "^171.4.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.15"
  }
}
