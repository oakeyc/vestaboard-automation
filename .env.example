# Vestaboard Read/Write API key.
# Enable Read/Write on your board at https://web.vestaboard.com/ → Settings → Enable Read/Write.
VESTABOARD_API_KEY=

# Optional override for the Vestaboard Read/Write API base URL.
# Leave unset to use the default (https://cloud.vestaboard.com).
# VESTABOARD_BASE_URL=https://cloud.vestaboard.com

# Google Calendar ID to read events from. Use "primary" for your default calendar,
# or paste the calendar ID from Google Calendar → Settings → Integrate calendar.
GOOGLE_CALENDAR_ID=primary

# Scheduler defaults. Each job can override its own cron expression / timezone.
# CALENDAR_CRON uses standard 5-field cron syntax (min hour dom mon dow).
# Default below: 7:00 AM every day.
CALENDAR_CRON=0 7 * * *
# IANA timezone for the calendar job. Defaults to process TZ / system timezone.
# CALENDAR_TZ=America/Los_Angeles
